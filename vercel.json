{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "crons": [
    {
      "path": "/health",
      "schedule": "*/5 * * * *"
    }
  ],
  "env": {
    "FRONTEND_URL": "https://attendance-management-frontend-five.vercel.app"
  }
}