# Copy to .env and fill in your values

# PostgreSQL (Neon) or SQLite for local dev
# DATABASE_URL=sqlite:///./attendance.db
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-gmail@gmail.com
# Use Gmail App Password (not your regular password)
# https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-16-char-app-password

SECRET_KEY=change-this-secret-key-in-production

# Local development
FRONTEND_URL=http://localhost:5173
# Production (set this on the hosted backend):
# FRONTEND_URL=https://attendance-management-frontend-five.vercel.app

# Optional: custom writable directory (defaults to /tmp on Vercel)
# WRITABLE_DIR=/tmp
